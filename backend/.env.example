# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://farmer:farmerpass@localhost:5432/farmerdb

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY

# Gemini AI — get from Google AI Studio
GEMINI_API_KEY=REPLACE_ME

# Weather — get from openweathermap.org (free tier)
OPENWEATHER_API_KEY=REPLACE_ME

# Vector DB — get from pinecone.io (free tier, optional)
PINECONE_API_KEY=
PINECONE_INDEX=farmer-memory

# Redis
REDIS_URL=redis://localhost:6379

# Twilio WhatsApp (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
